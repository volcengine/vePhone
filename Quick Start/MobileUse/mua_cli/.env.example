# Mobile Use Agent 配置文件
# 复制此文件为 .env 并填入真实值

# 火山引擎账号凭证 (必填)
VOLC_ACCESSKEY=your_access_key_id
VOLC_SECRETKEY=your_secret_access_key

# 云手机配置 (可在运行时动态传入)
TEST_PRODUCT_ID=your_product_id
TEST_POD_ID=your_pod_id

# TOS 对象存储 (可选, 用于存储截图/录屏)
TOS_BUCKET=your_tos_bucket
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing

# 方舟大模型 (可选, 用于 Agent 推理)
ARK_API_KEY=your_ark_api_key
ARK_MODEL_ID=your_ark_model_id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
