# 本地开发配置示例。
# 使用方式：复制本文件为 .env，然后按实际环境填写。
# 注意：.env 可能包含 AK/SK 等敏感信息，严禁提交到仓库。

# 可选。应用加密密钥，用于加密本地数据库中的敏感配置。
# 如果不配置，后端会自动生成并持久化到 data/secret.key。
# 如果配置，必须至少 32 个 UTF-8 字节。
APP_SECRET_KEY=change-this-local-secret-at-least-32-bytes

# 可选。应用运行环境：development / production。
APP_ENV=development

# 可选。本地数据目录，SQLite 数据库和自动生成的 secret.key 会放在这里。
APP_DATA_DIR=./data/computer_use_test_demo

# 可选。后端服务基础地址。
APP_BASE_URL=http://localhost:8001

# 可选。单次请求体最大字节数。
REQUEST_MAX_BYTES=1048576

# 可选。登录会话绝对有效期，单位：秒。默认 7 天。
AUTH_SESSION_LIFETIME_SECONDS=604800

# 可选。无 API 活动后的会话失效时间，单位：秒。默认 24 小时。
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=86400

# 可选。会话活跃时间写回数据库的最小间隔，单位：秒。
AUTH_SESSION_ACTIVITY_REFRESH_SECONDS=300

# 可选。任务默认执行超时时间，单位：秒。
TASK_EXECUTION_TIMEOUT_SECONDS=600

# 可选。任务取消确认等待时间，单位：秒。
CANCEL_CONFIRM_TIMEOUT_SECONDS=30

# 可选。指定设备全部离线、失联或被删除后，排队子任务失败前的等待时间，单位：秒。
# 设备仅繁忙或被其他任务占用时不会累计该超时。
DEVICE_WAIT_TIMEOUT_SECONDS=300

# 可选。服务停机时等待当前 Worker 任务自然结束的最长时间，范围 1 ~ 30 秒。
TASK_WORKER_DRAIN_TIMEOUT_SECONDS=30

# 可选。后端 Worker 同时执行的最大子任务数，范围 1 ~ 32。
# 每个任务还受业务空间上限、批次设备并发数和可用设备数限制。
TASK_WORKER_CONCURRENCY=16

# CUA 全局默认配置。前端“设置”页面保存后的数据库配置会优先于这里的默认值。
# 说明：当前代码仍读取 COMPUTER_USE_* 环境变量名，但这里的含义均对应 Computer Use Agent。

# 必填。火山引擎 Access Key ID，用于调用 CUA OpenAPI。
COMPUTER_USE_ACCESS_KEY_ID=your-access-key-id

# 必填。火山引擎 Secret Access Key，用于调用 CUA OpenAPI。
COMPUTER_USE_SECRET_ACCESS_KEY=your-secret-access-key

# 必填。火山账号 ID。设备池 ListCuaNode 按该账号查询 CUA 节点。
COMPUTER_USE_ACCOUNT_ID=your-volcengine-account-id

# 可选。TOS Bucket 名称。配置后用于任务截图、录屏或文件等执行产物存储。
COMPUTER_USE_TOS_BUCKET=your-tos-bucket

# 可选。TOS Endpoint。若配置 TOS Bucket，建议与 TosRegion 同时配置。
COMPUTER_USE_TOS_ENDPOINT=tos-s3-cn-beijing.volces.com

# 可选。TOS Region，例如 cn-beijing。配置 TOS Bucket 时建议填写。
COMPUTER_USE_TOS_REGION=cn-beijing

# 可选。CUA 任务最大步骤数，范围 1 ~ 500。文档默认值：100。
COMPUTER_USE_MAX_STEP=100

# 可选。CUA 一键执行接口超时时间，单位秒，范围 1 ~ 86400。文档默认值：120。
COMPUTER_USE_TIMEOUT_SECONDS=120

# 可选。回调配置 JSON 对象，例如 {"url":"https://example.com/callback"}。
COMPUTER_USE_CALLBACK_INFO=

# 可选。输出格式 JSON 字符串，例如 {"type":"object"}。
COMPUTER_USE_OUTPUT_SCHEMA=

# 可选。AI 调用失败重试次数，范围 1 ~ 10。文档默认值：3。
COMPUTER_USE_RETRY_LIMIT=3

# 可选。系统提示词；为空时使用平台内置默认提示词。
COMPUTER_USE_SYSTEM_PROMPT=

# 可选。第三方 MCP 工具配置 JSON 字符串，目前仅支持 URL。
COMPUTER_USE_MCP_JSON=

# 可选。模型单次响应最大输出 Token 数；为空表示不限制。
COMPUTER_USE_MAX_OUTPUT_TOKENS=

# 可选。发送给 CUA 上游接口的自定义 HTTP Header，JSON 对象格式；为空表示不附加。
# 注意：Authorization、Host、Content-Type、Content-Length、X-Date 等 SDK 保留头不允许覆盖。
# 示例：{"X-Env":"test","X-Request-Source":"cua"}
COMPUTER_USE_REQUEST_HEADERS=
